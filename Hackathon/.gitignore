!data/fixture.mp4
!data/fixture_ground_truth.json

# Python
__pycache__/
*.pyc
.pytest_cache/

# Secrets - never commit real credentials
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
