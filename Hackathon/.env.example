# VKE optional model providers.
# Copy this file to .env and fill in values. Everything works with none of
# these set - offline extraction/vision is the default. Setting these only
# upgrades Pass 2 enrichment (titles, visual descriptions, cited Q&A); it can
# never influence chunk boundaries (see docs/ARCHITECTURE.md).

# --- which providers to use ---
# offline (default, no key needed) | openai (any OpenAI-compatible endpoint)
VKE_LLM_PROVIDER=offline
VKE_VISION_PROVIDER=offline

# --- credentials ---
VKE_API_KEY=

# --- endpoint ---
# One adapter covers every vendor; only the base URL changes.
#   OpenAI:      https://api.openai.com/v1
#   Gemini:      https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama:      http://localhost:11434/v1
#   OpenRouter:  https://openrouter.ai/api/v1
VKE_BASE_URL=https://api.openai.com/v1

# --- models ---
VKE_LLM_MODEL=gpt-4o-mini
VKE_VISION_MODEL=gpt-4o-mini

# --- cost guard ---
# Hard cap on vision (VLM) calls per processing run. Only the displayed
# config's units are enriched, so this bounds the whole run's spend.
VKE_MAX_VISION_CALLS=40
