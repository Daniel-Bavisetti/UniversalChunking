# Copy this file to .env and fill in values as needed.
# All variables are optional; sensible defaults are used when unset.
#
# This file IS loaded at startup. A real environment variable always wins over
# a value set here, so `CLEAVE_LLM=none uv run pytest` still works offline.
# Values are validated once on first use: a bad number names the variable that
# caused it rather than failing later inside the pipeline.

# --- LLM provider selection ---
# Forces the provider choice: none | ollama | gemini
# Unset: prefers a locally running Ollama model, falls back to Gemini, then none.
CLEAVE_LLM=

# --- Gemini provider ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Ollama provider (local) ---
CLEAVE_OLLAMA_URL=http://127.0.0.1:11434
CLEAVE_OLLAMA_MODEL=

# --- LLM request tuning ---
CLEAVE_LLM_TIMEOUT=90

# --- Enrichment tuning ---
CLEAVE_ENRICH_BATCH=6
CLEAVE_ENRICH_DOC_CHARS=24000

# --- Speech-to-text service (audio ingestion) ---
CLEAVE_STT_URL=http://127.0.0.1:8000

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
CLEAVE_LOG_LEVEL=INFO
