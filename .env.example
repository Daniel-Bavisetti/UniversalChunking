# Copy this file to .env and fill in values as needed.
# All variables are optional; sensible defaults are used when unset.

# --- LLM provider selection ---
# Forces the provider choice: none | ollama | gemini
# Unset: prefers a locally running Ollama model, falls back to Gemini, then none.
CLEAVE_LLM=

# --- Gemini provider ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Ollama provider (local) ---
CLEAVE_OLLAMA_URL=http://127.0.0.1:11434
CLEAVE_OLLAMA_MODEL=

# --- LLM request tuning ---
CLEAVE_LLM_TIMEOUT=90

# --- Enrichment tuning ---
CLEAVE_ENRICH_BATCH=6
CLEAVE_ENRICH_DOC_CHARS=24000

# --- Speech-to-text service (audio ingestion) ---
CLEAVE_STT_URL=http://127.0.0.1:8000

# --- Visual understanding (images, PDF figures) ---
# OCR and object detection run locally with no key. A vision-capable LLM adds
# structured figure understanding (visual_type, entities, relationships).
CLEAVE_VISION=auto

# --- Video engine (vke/) ---
# Which engine draws video boundaries: cleave | vke
#   cleave — one chunker for every modality, directly comparable receipts
#   vke    — the multimodal boundary model, which can see scene cuts
CLEAVE_VIDEO_BOUNDARIES=vke
CLEAVE_VKE_CONFIG=vke_multimodal

# VKE's own optional providers (offline by default; never affect boundaries).
VKE_LLM_PROVIDER=offline
VKE_VISION_PROVIDER=offline
VKE_API_KEY=
VKE_BASE_URL=https://api.openai.com/v1
VKE_LLM_MODEL=gpt-4o-mini
VKE_VISION_MODEL=gpt-4o-mini
VKE_MAX_VISION_CALLS=40

# --- Web ingestion ---
# Static extraction (trafilatura) runs first; a rendered fetch (crawl4ai) is
# used only when the page turns out to need JavaScript.
CLEAVE_WEB_TIMEOUT=45
CLEAVE_WEB_MIN_CHARS=600
CLEAVE_WEB_MAX_CHARS=400000
