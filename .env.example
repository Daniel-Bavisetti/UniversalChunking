# Copy this file to .env and fill in values as needed.
# All variables are optional; sensible defaults are used when unset.
#
# This file IS loaded at startup. A real environment variable always wins over
# a value set here, so `CLEAVE_LLM=none uv run pytest` still works offline.
# Values are validated once on first use: a bad number names the variable that
# caused it rather than failing later inside the pipeline.

# --- LLM provider selection ---
# Forces the provider choice: none | ollama | gemini
# Unset: prefers a locally running Ollama model, falls back to Gemini, then none.
CLEAVE_LLM=

# --- Gemini provider ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Ollama provider (local) ---
CLEAVE_OLLAMA_URL=http://127.0.0.1:11434
CLEAVE_OLLAMA_MODEL=

# --- LLM request tuning ---
CLEAVE_LLM_TIMEOUT=90

# --- Enrichment tuning ---
CLEAVE_ENRICH_BATCH=6
CLEAVE_ENRICH_DOC_CHARS=24000

# --- Speech-to-text service (audio ingestion) ---
CLEAVE_STT_URL=http://127.0.0.1:8000

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
CLEAVE_LOG_LEVEL=INFO

# --- Video processing ---
CLEAVE_VIDEO_URL=http://127.0.0.1:8001

# Set to 1 in evaluation/test environments to enable synthetic offline fallback.
# In production keep this unset (defaults to 0).
CLEAVE_EVALUATION_MODE=0

# Set to 0 in production to prevent synthetic fallback from silently replacing
# real video data. When 0 and workers are unavailable, VideoWorkerUnavailable is raised.
CLEAVE_ALLOW_SYNTHETIC_FALLBACK=1

# Boundary scoring weight for a shot-only camera cut (default 0.35).
# Scene changes stay at 0.85. Reduce to de-emphasize camera cuts further.
CLEAVE_WEIGHT_SHOT_CHANGE=0.35

# Minimum boundary score for a speaker change to force a multimodal event split
# when used alongside other signals (default 0.55).
CLEAVE_SPEAKER_BOUNDARY_THRESHOLD=0.55

